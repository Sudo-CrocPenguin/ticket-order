# API
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=*
JWT_SECRET=change-this-secret-before-production-32-chars
TOKEN_EXPIRES_IN_SECONDS=86400

# Local persistence. These paths are ignored by git.
DATA_FILE=./data/ticket-order.json
UPLOAD_DIR=./uploads

# Seed data for the first boot.
SEED_COMPANY_NAME=Empresa Demo
SEED_COMPANY_SLUG=empresa-demo
SEED_APPLICATION_NAME=Aplicacion Principal
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# Client env files live with each app:
# - apps/mobile/.env.example
# - apps/web/.env.example
