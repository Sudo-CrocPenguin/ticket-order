# API
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=*
JWT_SECRET=change-this-secret-before-production-32-chars
TOKEN_EXPIRES_IN_SECONDS=86400

# Local persistence. These paths are ignored by git.
DATA_FILE=./data/ticket-order.json
UPLOAD_DIR=./uploads

# Seed data for the first boot.
SEED_COMPANY_NAME=Empresa Demo
SEED_COMPANY_SLUG=empresa-demo
SEED_APPLICATION_NAME=Aplicacion Principal
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# Expo client. Supabase is the central backend used by the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Legacy local API. Keep only if you still run the old JSON server manually.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
