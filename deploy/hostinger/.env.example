NODE_ENV=production
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=https://tickets.tu-dominio.com
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
TOKEN_EXPIRES_IN_SECONDS=86400
DATA_FILE=/app/data/ticket-order.json
UPLOAD_DIR=/app/uploads

SEED_COMPANY_NAME=Tu Empresa
SEED_COMPANY_SLUG=tu-empresa
SEED_APPLICATION_NAME=Aplicacion Principal
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@tu-dominio.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
