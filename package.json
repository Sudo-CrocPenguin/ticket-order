{
  "name": "ticket-order",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm --prefix apps/mobile run start",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:web": "npm --prefix apps/mobile run web",
    "mobile:build:web": "npm --prefix apps/mobile run build:web",
    "api": "node server/src/main.js",
    "dev:api": "node server/src/main.js",
    "android": "npm run mobile:android",
    "ios": "npm run mobile:ios",
    "web": "npm run web:app:dev",
    "web:app:dev": "npm --prefix apps/web run dev",
    "web:app:build": "npm --prefix apps/web run build",
    "web:app:start": "npm --prefix apps/web run start",
    "build:web": "npm run web:app:build",
    "build:mobile:web": "npm run mobile:build:web",
    "test": "node --test \"shared/**/*.test.js\" \"server/**/*.test.js\""
  }
}
